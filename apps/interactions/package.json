{
  "name": "@onehost/interactions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "register": "tsx src/register.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:@google-cloud/pubsub --outfile=dist/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@onehost/core": "workspace:*",
    "@google-cloud/pubsub": "^4.7.0",
    "@onehost/jobs": "workspace:*",
    "discord-interactions": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "~0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
